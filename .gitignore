# ─────────────────────────────────────────────────────────────────────────────
# Pankha – .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Local .NET SDK (downloaded by build.bat for machines without .NET 10) ────
.dotnet/

# ── Build output ─────────────────────────────────────────────────────────────
bin/
obj/
dist/

# ── Installer binaries (compiled artifacts, not source) ──────────────────────
installer/*.exe

# ── .NET / MSBuild ────────────────────────────────────────────────────────────
*.user
*.suo
*.sln.docstates
project.lock.json
project.assets.json
*.nupkg
*.snk

# ── Compiled binaries ────────────────────────────────────────────────────────
*.dll
*.exe
*.pdb
*.app

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Node (not used – guard against accidental npm init) ──────────────────────
node_modules/
package-lock.json

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.iml

# ── Temporary / generated files ──────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.swo
*.orig
*.cache

# ── Environment ──────────────────────────────────────────────────────────────
.env

# ── Tauri / Rust ─────────────────────────────────────────────────────────────
src-tauri/target/
src-tauri/binaries/
dist/
dist-isolated/
