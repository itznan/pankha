/* ===================================================================
   PANKHA – Fan Control Application
   Dark Theme – Inspired by Prism Launcher
   =================================================================== */

/* ── Global Reset ─────────────────────────────────────────────────── */
* {
    outline: none;
}

QWidget {
    background-color: #0f1117;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #c8d3e0;
}

QMainWindow {
    background-color: #0f1117;
}

/* ── Scrollbar ────────────────────────────────────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 5px;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: #2a3448;
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #3b4d6a;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* ── Panes ────────────────────────────────────────────────────────── */
QFrame#leftPane {
    background-color: #0c0e16;
    border-right: 1px solid #1a2035;
}

QFrame#rightPane {
    background-color: #0f1117;
}

/* ── Sidebar Header ───────────────────────────────────────────────── */
QLabel#appNameLabel {
    font-size: 16px;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 1.5px;
}

QLabel#appVersionLabel {
    font-size: 9px;
    font-weight: 700;
    color: #3b82f6;
    background-color: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.30);
    border-radius: 3px;
    padding: 1px 5px;
}

QLabel#appAuthorLabel {
    font-size: 10px;
    color: #2d3d58;
    font-weight: 500;
}

/* ── Separator Line ───────────────────────────────────────────────── */
QFrame#headerSeparator {
    background-color: #1a2035;
    max-height: 1px;
    border: none;
}

/* ── Fan Cards ────────────────────────────────────────────────────── */
QFrame.FanCard {
    background-color: #141826;
    border: 1px solid #1a2035;
    border-left: 3px solid transparent;
    border-radius: 8px;
}

QFrame.FanCard:hover {
    background-color: #18213a;
    border-color: #243050;
    border-left-color: #3b82f6;
}

QFrame.FanCard[selected="true"] {
    background-color: #172040;
    border: 1px solid #2a4070;
    border-left: 3px solid #3b82f6;
}

QLabel#fanCardName {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
}

QLabel#fanCardHardware {
    font-size: 10px;
    color: #3a4d6a;
}

QLabel#fanCardRpm {
    font-size: 13px;
    font-weight: 700;
    color: #60a5fa;
}

/* ── Fan Card Progress Bar ────────────────────────────────────────── */
QFrame.FanCard QProgressBar {
    background-color: #1a2035;
    border: none;
    border-radius: 2px;
    height: 4px;
    min-height: 4px;
    max-height: 4px;
}

QFrame.FanCard QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #60a5fa);
    border-radius: 2px;
}

/* ── Mode Badges ──────────────────────────────────────────────────── */
QLabel#badgeAuto {
    background-color: rgba(34, 197, 94, 0.12);
    color: #4ade80;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(34, 197, 94, 0.25);
}

QLabel#badgeManual {
    background-color: rgba(251, 191, 36, 0.12);
    color: #fbbf24;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(251, 191, 36, 0.25);
}

QLabel#badgeMonitor {
    background-color: rgba(100, 116, 139, 0.12);
    color: #64748b;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(100, 116, 139, 0.20);
}

/* ── Detail Panel Header ──────────────────────────────────────────── */
QLabel#detailTitle {
    font-size: 20px;
    font-weight: 700;
    color: #f1f5f9;
}

QLabel#detailHardware {
    font-size: 11px;
    color: #3a4d6a;
    font-weight: 500;
}

/* ── Section Sub-labels ───────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 10px;
    color: #3b5070;
    font-weight: 700;
    letter-spacing: 0.6px;
}

/* ── Group Boxes ──────────────────────────────────────────────────── */
QGroupBox {
    background-color: #111622;
    border: 1px solid #1a2035;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 24px;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 6px;
    padding: 1px 8px;
    color: #3b5070;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background-color: #111622;
    border-radius: 4px;
}

/* ── Input Controls ───────────────────────────────────────────────── */
QComboBox,
QLineEdit,
QSpinBox {
    background-color: #141826;
    border: 1px solid #1e2840;
    border-radius: 6px;
    color: #dde4ed;
    padding: 5px 10px;
    min-height: 26px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus {
    border-color: #3b82f6;
    background-color: #161d30;
}

QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #0c0e16;
    color: #222d40;
    border-color: #141826;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 18px;
    background-color: #1a2035;
    border: none;
    border-radius: 3px;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #243050;
}
QSpinBox::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #64748b;
}
QSpinBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748b;
}

/* ── Slider ───────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #1a2035;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #2563eb, stop:1 #60a5fa);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #f0f6ff;
    border: 2px solid #3b82f6;
    width: 16px;
    height: 16px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #3b82f6;
    border-color: #f0f6ff;
}

QSlider::handle:horizontal:pressed {
    background: #2563eb;
    border-color: #f0f6ff;
}

QSlider::groove:horizontal:disabled {
    background: #111622;
}

QSlider::sub-page:horizontal:disabled {
    background: #1a2035;
}

QSlider::handle:horizontal:disabled {
    background: #1a2035;
    border-color: #141826;
}

/* ── Telemetry Progress Bar ───────────────────────────────────────── */
QProgressBar {
    background-color: #141826;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: rgba(255, 255, 255, 0.0);
    font-weight: 600;
    font-size: 11px;
    min-height: 8px;
    max-height: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #059669, stop:1 #34d399);
    border-radius: 6px;
}

/* ── Buttons ──────────────────────────────────────────────────────── */
QPushButton {
    background-color: #141826;
    border: 1px solid #1e2840;
    border-radius: 7px;
    color: #9aafca;
    font-weight: 600;
    font-size: 12px;
    padding: 7px 18px;
    min-height: 34px;
}

QPushButton:hover {
    background-color: #1a2340;
    border-color: #3b82f6;
    color: #dde4ed;
}

QPushButton:pressed {
    background-color: #0c0e16;
    border-color: #2563eb;
}

QPushButton:disabled {
    background-color: #0c0e16;
    border-color: #131825;
    color: #1e2840;
}

/* Apply Button – primary action */
QPushButton#applyButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3b82f6, stop:1 #2563eb);
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.3px;
}

QPushButton#applyButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #60a5fa, stop:1 #3b82f6);
    border-color: #3b82f6;
}

QPushButton#applyButton:pressed {
    background: #1d4ed8;
    border-color: #1e40af;
}

QPushButton#applyButton:disabled {
    background: #0c0e16;
    color: #1e2840;
    border: 1px solid #131825;
}

/* Rescan Button */
QPushButton#rescanButton {
    font-size: 11px;
    padding: 5px 14px;
    min-height: 28px;
    border-radius: 6px;
}

/* ── Checkboxes ───────────────────────────────────────────────────── */
QCheckBox {
    spacing: 9px;
    font-weight: 500;
    color: #9aafca;
    font-size: 12px;
}

QCheckBox:hover {
    color: #dde4ed;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/check_off.svg);
}

QCheckBox::indicator:checked {
    image: url(:/check_on.svg);
}

QCheckBox::indicator:unchecked:disabled,
QCheckBox::indicator:checked:disabled {
    image: url(:/check_disabled.svg);
}

QCheckBox:disabled {
    color: #1e2840;
}

/* ── Status Bar ───────────────────────────────────────────────────── */
QStatusBar {
    background-color: #090c12;
    border-top: 1px solid #141826;
    color: #3b5070;
    font-size: 11px;
    padding: 0 4px;
}

QStatusBar QLabel {
    background: transparent;
    color: #3b5070;
    padding: 2px 6px;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a2340;
    border: 1px solid #2a3d60;
    color: #dde4ed;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 12px;
}

/* ── Message Box ──────────────────────────────────────────────────── */
QMessageBox {
    background-color: #111622;
}
QMessageBox QLabel {
    color: #c8d3e0;
}
QMessageBox QPushButton {
    min-width: 80px;
}
