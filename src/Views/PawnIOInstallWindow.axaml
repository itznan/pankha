<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="frontend_avalonia.Views.PawnIOInstallWindow"
        Title="Pankha – Driver Setup"
        Width="480" Height="340"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Icon="/Assets/logo.png"
        Name="PawnIOSetupWindow">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background"      Value="#10B981"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0EA271"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#2a2a2e"/>
            <Setter Property="Foreground"      Value="#86868b"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="20,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a3a3e"/>
        </Style>
    </Window.Styles>

    <!-- Mica-style background -->
    <Border Background="#DD1c1c1e"
            CornerRadius="14"
            Padding="36,32">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Fan icon SVG-like shape using a TextBlock emoji -->
                    <TextBlock Text="🔧" FontSize="28" VerticalAlignment="Center"/>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Driver Setup Required"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#f5f5f7"/>
                        <TextBlock Text="PawnIO kernel driver not found"
                                   FontSize="12" Foreground="#86868b"/>
                    </StackPanel>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#20ffffff" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="14">

                <TextBlock TextWrapping="Wrap"
                           LineHeight="22"
                           Foreground="#d0d0d5"
                           FontSize="13"
                           Text="Pankha requires the PawnIO kernel driver to read and control your fan speeds. PawnIO is a lightweight, open-source, Microsoft-signed driver by namazso."/>

                <Border Background="#12ffffff"
                        CornerRadius="8"
                        Padding="14,10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="What will happen:"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#86868b"/>
                        <TextBlock Text="• Download PawnIO installer from GitHub (~5 MB)"
                                   FontSize="12" Foreground="#c0c0c5"/>
                        <TextBlock Text="• Install it silently (requires this app to run as Admin)"
                                   FontSize="12" Foreground="#c0c0c5"/>
                        <TextBlock Text="• A restart may be required after installation"
                                   FontSize="12" Foreground="#c0c0c5"/>
                    </StackPanel>
                </Border>

                <!-- Progress area (hidden until install starts) -->
                <StackPanel Name="ProgressPanel" IsVisible="False" Spacing="8">
                    <ProgressBar Name="InstallProgress"
                                 Minimum="0" Maximum="100" Value="0"
                                 Height="6" CornerRadius="3"
                                 Foreground="#10B981"
                                 Background="#30ffffff"/>
                    <TextBlock Name="StatusLabel"
                               Text="Starting…"
                               FontSize="12" Foreground="#86868b"/>
                </StackPanel>

            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,20,0,0">
                <Button Name="SkipButton"
                        Classes="secondary"
                        Content="Skip for now"
                        Click="OnSkip"/>
                <Button Name="InstallButton"
                        Classes="primary"
                        Content="Install PawnIO"
                        Click="OnInstall"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
