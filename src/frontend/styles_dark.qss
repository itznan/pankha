/* ===================================================================
   PANKHA – Fan Control Application
   macOS Sequoia Dark Theme
   =================================================================== */

/* ── Global Reset & Fonts ─────────────────────────────────────────── */
* {
    outline: none;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #f5f5f7;
}

QMainWindow {
    background-color: #1e1e1e;
}

QLabel, QCheckBox {
    background-color: transparent;
}

/* ── Scrollbar ────────────────────────────────────────────────────── */
QScrollArea, 
QScrollArea > QWidget, 
QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    min-height: 30px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.3);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* ── Panes ────────────────────────────────────────────────────────── */
QFrame#leftPane {
    background-color: #262626;
    border-right: 1px solid #323232;
}

QFrame#rightPane {
    background-color: #1e1e1e;
}

/* ── macOS traffic lights ─────────────────────────────────────────── */
QPushButton#macCloseDot {
    background-color: #FF5F56;
    border: 1px solid #E0443E;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    color: transparent;
    font-size: 8px;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}
QPushButton#macCloseDot:hover {
    color: #4c0000;
}
QPushButton#macMinimizeDot {
    background-color: #FFBD2E;
    border: 1px solid #DEA123;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    color: transparent;
    font-size: 8px;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}
QPushButton#macMinimizeDot:hover {
    color: #5c3e00;
}
QPushButton#macMaximizeDot {
    background-color: #27C93F;
    border: 1px solid #1AAB2F;
    border-radius: 6px;
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    color: transparent;
    font-size: 8px;
    font-weight: bold;
    text-align: center;
    padding: 0px;
    margin: 0px;
}
QPushButton#macMaximizeDot:hover {
    color: #003300;
}

/* ── Sidebar Header ───────────────────────────────────────────────── */
QLabel#appNameLabel {
    font-size: 14px;
    font-weight: 700;
    color: #f5f5f7;
    letter-spacing: 0.5px;
}

QLabel#appVersionLabel {
    font-size: 9px;
    font-weight: 600;
    color: #86868b;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 1px 4px;
}

QLabel#appAuthorLabel {
    font-size: 10px;
    color: #86868b;
    font-weight: 400;
}

/* ── Separator Line ───────────────────────────────────────────────── */
QFrame#headerSeparator {
    background-color: #323232;
    max-height: 1px;
    border: none;
}

/* ── Fan Cards ────────────────────────────────────────────────────── */
QFrame.FanCard {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
}

QFrame.FanCard:hover {
    background-color: #353537;
    border-color: #48484a;
}

QFrame.FanCard[selected="true"] {
    background-color: #007aff;
    border: 1px solid #0066cc;
}

/* Selected Card Child Styling overrides */
QFrame.FanCard[selected="true"] QLabel {
    color: #ffffff;
}

QFrame.FanCard[selected="true"] QLabel#fanCardName {
    color: #ffffff;
}

QFrame.FanCard[selected="true"] QLabel#fanCardHardware {
    color: rgba(255, 255, 255, 0.75);
}

QFrame.FanCard[selected="true"] QLabel#fanCardRpm {
    color: #ffffff;
}

QLabel#fanCardName {
    font-size: 13px;
    font-weight: 600;
    color: #f5f5f7;
}

QLabel#fanCardHardware {
    font-size: 10px;
    color: #86868b;
}

QLabel#fanCardRpm {
    font-size: 13px;
    font-weight: 700;
    color: #007aff;
}

/* ── Fan Card Progress Bar ────────────────────────────────────────── */
QFrame.FanCard QProgressBar {
    background-color: #3a3a3c;
    border: none;
    border-radius: 2px;
    height: 4px;
    min-height: 4px;
    max-height: 4px;
}

QFrame.FanCard QProgressBar::chunk {
    background-color: #007aff;
    border-radius: 2px;
}

QFrame.FanCard[selected="true"] QProgressBar {
    background-color: rgba(255, 255, 255, 0.3);
}

QFrame.FanCard[selected="true"] QProgressBar::chunk {
    background-color: #ffffff;
}

/* ── Mode Badges ──────────────────────────────────────────────────── */
QLabel#badgeAuto {
    background-color: rgba(48, 209, 88, 0.15);
    color: #30d158;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(48, 209, 88, 0.3);
}

QLabel#badgeManual {
    background-color: rgba(255, 159, 10, 0.15);
    color: #ff9f0a;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(255, 159, 10, 0.3);
}

QLabel#badgeMonitor {
    background-color: rgba(142, 142, 147, 0.15);
    color: #98989d;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid rgba(142, 142, 147, 0.25);
}

QFrame.FanCard[selected="true"] QLabel#badgeAuto {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
    border: none;
}

QFrame.FanCard[selected="true"] QLabel#badgeManual {
    background-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    border: none;
}

QFrame.FanCard[selected="true"] QLabel#badgeMonitor {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border: none;
}

/* ── Detail Panel Header ──────────────────────────────────────────── */
QLabel#detailTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f5f5f7;
}

QLabel#detailHardware {
    font-size: 11px;
    color: #86868b;
    font-weight: 500;
}

/* ── Section Sub-labels ───────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 10px;
    color: #86868b;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ── Group Boxes ──────────────────────────────────────────────────── */
QGroupBox {
    background-color: #1e1e1e;
    border: 1px solid #323232;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 24px;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 6px;
    padding: 1px 8px;
    color: #f5f5f7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background-color: #1e1e1e;
}

/* ── Input Controls ───────────────────────────────────────────────── */
QComboBox,
QLineEdit,
QSpinBox {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 5px;
    color: #f5f5f7;
    padding: 4px 8px;
    min-height: 24px;
    selection-background-color: #007aff;
    selection-color: #ffffff;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus {
    border-color: #007aff;
}

QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled {
    background-color: #1e1e1e;
    color: #555558;
    border-color: #2c2c2e;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 16px;
    background-color: #3a3a3c;
    border: none;
}
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #48484a;
}
QSpinBox::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #86868b;
}
QSpinBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #86868b;
}

/* ── Slider ───────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #3a3a3c;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #007aff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #555555;
    width: 18px;
    height: 18px;
    margin-top: -7px;
    margin-bottom: -7px;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #888888;
}

QSlider::handle:horizontal:pressed {
    background: #f5f5f7;
    border-color: #007aff;
}

QSlider::groove:horizontal:disabled {
    background: #2c2c2e;
}

QSlider::sub-page:horizontal:disabled {
    background: #3a3a3c;
}

QSlider::handle:horizontal:disabled {
    background: #3a3a3c;
    border-color: #2c2c2e;
}

/* ── Telemetry Progress Bar ───────────────────────────────────────── */
QProgressBar {
    background-color: #2c2c2e;
    border: none;
    border-radius: 3px;
    text-align: center;
    color: rgba(255, 255, 255, 0.0);
    min-height: 6px;
    max-height: 6px;
}

QProgressBar::chunk {
    background: #30d158; /* Apple Green for Dark Mode */
    border-radius: 3px;
}

/* ── Buttons ──────────────────────────────────────────────────────── */
QPushButton {
    background-color: #3a3a3c;
    border: 1px solid #48484a;
    border-radius: 5px;
    color: #f5f5f7;
    font-weight: 500;
    font-size: 12px;
    padding: 5px 14px;
    min-height: 28px;
}

QPushButton:hover {
    background-color: #48484a;
}

QPushButton:pressed {
    background-color: #545456;
}

QPushButton:disabled {
    background-color: #2c2c2e;
    border-color: #3a3a3c;
    color: #555558;
}

/* Apply Button – Apple Blue primary */
QPushButton#applyButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0088ff, stop:1 #007aff);
    border: 1px solid #0066cc;
    border-bottom: 1px solid #0055b3;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#applyButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1a94ff, stop:1 #1a85ff);
    border-color: #0055b3;
}

QPushButton#applyButton:pressed {
    background: #0066cc;
    border-color: #0055b3;
}

QPushButton#applyButton:disabled {
    background: #2c2c2e;
    color: #555558;
    border: 1px solid #3a3a3c;
}

/* Rescan Button */
QPushButton#rescanButton {
    font-size: 11px;
    padding: 4px 10px;
    min-height: 26px;
    border-radius: 5px;
}

/* ── Checkboxes ───────────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    font-weight: 500;
    color: #f5f5f7;
    font-size: 12px;
}

QCheckBox:hover {
    color: #007aff;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(:/icons/check_off.svg);
}

QCheckBox::indicator:checked {
    image: url(:/icons/check_on.svg);
}

QCheckBox::indicator:unchecked:disabled,
QCheckBox::indicator:checked:disabled {
    image: url(:/icons/check_disabled.svg);
}

QCheckBox:disabled {
    color: #555558;
}

/* ── Status Bar ───────────────────────────────────────────────────── */
QStatusBar {
    background-color: #262626;
    border-top: 1px solid #323232;
    color: #86868b;
    font-size: 11px;
    padding: 0 4px;
}

QStatusBar QLabel {
    background: transparent;
    color: #86868b;
    padding: 2px 6px;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: #3a3a3c;
    border: none;
    color: #ffffff;
    padding: 4px 8px;
    border-radius: 5px;
    font-size: 11px;
}

/* ── Message Box ──────────────────────────────────────────────────── */
QMessageBox {
    background-color: #1e1e1e;
}
QMessageBox QLabel {
    color: #f5f5f7;
}
QMessageBox QPushButton {
    min-width: 70px;
}
