/* ===================================================================
   PANKHA – Fan Control Application
   macOS Sequoia Dark Theme — Production Quality
   =================================================================== */

/* ── Global Reset & Fonts ─────────────────────────────────────────── */
* {
    outline: none;
}

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 13px;
    color: #f5f5f7;
}

QMainWindow {
    background-color: #1e1e1e;
}

QLabel, QCheckBox {
    background-color: transparent;
}

/* ── Scrollbar ────────────────────────────────────────────────────── */
QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.18);
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.35);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.18);
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.35);
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── Panes ────────────────────────────────────────────────────────── */
QFrame#leftPane {
    background-color: #282828;
    border-right: 1px solid #3a3a3c;
}

QFrame#rightPane {
    background-color: #1e1e1e;
}

/* ── macOS traffic lights ─────────────────────────────────────────── */
QPushButton#macCloseDot {
    background-color: #FF5F56;
    border: 1px solid #E0443E;
    border-radius: 6px;
    min-width: 12px; max-width: 12px;
    min-height: 12px; max-height: 12px;
    color: transparent;
    font-size: 8px; font-weight: bold;
    text-align: center;
    padding: 0px; margin: 0px;
}
QPushButton#macCloseDot:hover {
    color: #4c0000;
    background-color: #FF4136;
}
QPushButton#macMinimizeDot {
    background-color: #FFBD2E;
    border: 1px solid #DEA123;
    border-radius: 6px;
    min-width: 12px; max-width: 12px;
    min-height: 12px; max-height: 12px;
    color: transparent;
    font-size: 8px; font-weight: bold;
    text-align: center;
    padding: 0px; margin: 0px;
}
QPushButton#macMinimizeDot:hover {
    color: #5c3e00;
    background-color: #FFB420;
}
QPushButton#macMaximizeDot {
    background-color: #27C93F;
    border: 1px solid #1AAB2F;
    border-radius: 6px;
    min-width: 12px; max-width: 12px;
    min-height: 12px; max-height: 12px;
    color: transparent;
    font-size: 8px; font-weight: bold;
    text-align: center;
    padding: 0px; margin: 0px;
}
QPushButton#macMaximizeDot:hover {
    color: #003300;
    background-color: #1FC034;
}

/* ── Sidebar Header ───────────────────────────────────────────────── */
QLabel#appNameLabel {
    font-size: 16px;
    font-weight: 800;
    color: #f5f5f7;
    letter-spacing: 1.0px;
}

QLabel#appVersionLabel {
    font-size: 9px;
    font-weight: 600;
    color: #98989d;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 1px 5px;
}

QLabel#appAuthorLabel {
    font-size: 10px;
    color: #98989d;
    font-weight: 400;
}

/* ── Separator Line ───────────────────────────────────────────────── */
QFrame#headerSeparator {
    background-color: #3a3a3c;
    max-height: 1px;
    border: none;
}

/* ── Fan Cards ────────────────────────────────────────────────────── */
QFrame.FanCard {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 10px;
}

QFrame.FanCard:hover {
    background-color: #363638;
    border-color: #48484a;
}

QFrame.FanCard[selected="true"] {
    background-color: #007aff;
    border: 1px solid #0062cc;
}

QFrame.FanCard[selected="true"] QLabel { color: #ffffff; }
QFrame.FanCard[selected="true"] QLabel#fanCardName { color: #ffffff; }
QFrame.FanCard[selected="true"] QLabel#fanCardHardware { color: rgba(255, 255, 255, 0.78); }
QFrame.FanCard[selected="true"] QLabel#fanCardRpm { color: #ffffff; font-weight: 800; }

QLabel#fanCardName {
    font-size: 13px;
    font-weight: 600;
    color: #f5f5f7;
}

QLabel#fanCardHardware {
    font-size: 10px;
    color: #98989d;
}

QLabel#fanCardRpm {
    font-size: 13px;
    font-weight: 700;
    color: #0a84ff;
}

/* ── Fan Card Progress Bar ────────────────────────────────────────── */
QFrame.FanCard QProgressBar {
    background-color: #3a3a3c;
    border: none;
    border-radius: 2px;
    height: 4px; min-height: 4px; max-height: 4px;
}

QFrame.FanCard QProgressBar::chunk {
    background-color: #0a84ff;
    border-radius: 2px;
}

QFrame.FanCard[selected="true"] QProgressBar {
    background-color: rgba(255, 255, 255, 0.28);
}

QFrame.FanCard[selected="true"] QProgressBar::chunk {
    background-color: #ffffff;
}

/* ── Mode Badges ──────────────────────────────────────────────────── */
QLabel#badgeAuto {
    background-color: rgba(48, 209, 88, 0.15);
    color: #30d158;
    font-size: 9px; font-weight: 700; letter-spacing: 0.3px;
    padding: 2px 7px; border-radius: 4px;
    border: 1px solid rgba(48, 209, 88, 0.3);
}

QLabel#badgeManual {
    background-color: rgba(255, 159, 10, 0.15);
    color: #ff9f0a;
    font-size: 9px; font-weight: 700; letter-spacing: 0.3px;
    padding: 2px 7px; border-radius: 4px;
    border: 1px solid rgba(255, 159, 10, 0.3);
}

QLabel#badgeMonitor {
    background-color: rgba(142, 142, 147, 0.15);
    color: #98989d;
    font-size: 9px; font-weight: 700; letter-spacing: 0.3px;
    padding: 2px 7px; border-radius: 4px;
    border: 1px solid rgba(142, 142, 147, 0.25);
}

QFrame.FanCard[selected="true"] QLabel#badgeAuto {
    background-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QFrame.FanCard[selected="true"] QLabel#badgeManual {
    background-color: rgba(255, 255, 255, 0.28);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QFrame.FanCard[selected="true"] QLabel#badgeMonitor {
    background-color: rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

/* ── Detail Panel Header ──────────────────────────────────────────── */
QLabel#detailTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f5f5f7;
}

QLabel#detailHardware {
    font-size: 12px;
    color: #98989d;
    font-weight: 500;
}

/* ── Section Sub-labels ───────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 10px;
    color: #98989d;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* ── Group Boxes ──────────────────────────────────────────────────── */
QGroupBox {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3c;
    border-radius: 12px;
    margin-top: 18px;
    padding-top: 28px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px; top: 8px;
    padding: 2px 10px;
    color: #f5f5f7;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background-color: #1e1e1e;
}

/* ── Input Controls ───────────────────────────────────────────────── */
QComboBox,
QLineEdit,
QSpinBox {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    color: #f5f5f7;
    padding: 5px 10px;
    min-height: 26px;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border-color: #0a84ff;
}

QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled {
    background-color: #1e1e1e;
    color: #48484a;
    border-color: #2c2c2e;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #98989d;
}

QComboBox QAbstractItemView {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 6px;
    color: #f5f5f7;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3a3a3c;
}

QSpinBox::up-button, QSpinBox::down-button {
    width: 18px;
    background-color: #3a3a3c;
    border: none;
    border-radius: 3px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #48484a;
}
QSpinBox::up-arrow {
    image: none; width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #98989d;
}
QSpinBox::down-arrow {
    image: none; width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #98989d;
}

/* ── Slider ───────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #3a3a3c;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0a84ff;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #f5f5f7;
    border: 2px solid #0a84ff;
    width: 20px; height: 20px;
    margin-top: -7px;
    margin-bottom: -7px;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background: #e0e0e3;
    border-color: #0062cc;
}

QSlider::handle:horizontal:pressed {
    background: #d1d1d6;
    border-color: #0050a8;
}

QSlider::groove:horizontal:disabled { background: #2c2c2e; }
QSlider::sub-page:horizontal:disabled { background: #3a3a3c; }
QSlider::handle:horizontal:disabled {
    background: #3a3a3c;
    border-color: #2c2c2e;
}

/* ── Telemetry Progress Bar ───────────────────────────────────────── */
QProgressBar {
    background-color: #2c2c2e;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: rgba(255, 255, 255, 0.0);
    min-height: 8px;
    max-height: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #30d158, stop:1 #28b84d);
    border-radius: 4px;
}

/* ── Buttons ──────────────────────────────────────────────────────── */
QPushButton {
    background-color: #3a3a3c;
    border: 1px solid #48484a;
    border-bottom: 2px solid #555558;
    border-radius: 7px;
    color: #f5f5f7;
    font-weight: 500;
    font-size: 12px;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #48484a;
    border-color: #555558;
}

QPushButton:pressed {
    background-color: #545456;
    border-bottom: 1px solid #555558;
    padding-top: 7px;
}

QPushButton:disabled {
    background-color: #2c2c2e;
    border-color: #3a3a3c;
    border-bottom: 1px solid #3a3a3c;
    color: #48484a;
}

/* Apply Button */
QPushButton#applyButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1a8fff, stop:1 #007aff);
    border: 1px solid #0062cc;
    border-bottom: 2px solid #0050a8;
    border-radius: 7px;
    color: #ffffff;
    font-weight: 600;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton#applyButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3da1ff, stop:1 #1a8fff);
    border-color: #0055b3;
}

QPushButton#applyButton:pressed {
    background: #0062cc;
    border-bottom: 1px solid #0050a8;
    padding-top: 7px;
}

QPushButton#applyButton:disabled {
    background: #2c2c2e;
    color: #48484a;
    border: 1px solid #3a3a3c;
    border-bottom: 1px solid #3a3a3c;
}


/* Rescan / Settings Buttons */
QPushButton#rescanButton {
    font-size: 11px;
    padding: 4px 12px;
    min-height: 28px;
    border-radius: 6px;
}

QPushButton#settingsButton {
    font-size: 11px;
    padding: 4px 12px;
    min-height: 28px;
    border-radius: 6px;
}

/* ── Checkboxes ───────────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    font-weight: 500;
    color: #f5f5f7;
    font-size: 12px;
}

QCheckBox:hover { color: #0a84ff; }

QCheckBox::indicator { width: 18px; height: 18px; }
QCheckBox::indicator:unchecked { image: url(:/icons/check_off.svg); }
QCheckBox::indicator:checked { image: url(:/icons/check_on.svg); }
QCheckBox::indicator:unchecked:disabled,
QCheckBox::indicator:checked:disabled { image: url(:/icons/check_disabled.svg); }
QCheckBox:disabled { color: #48484a; }

/* ── Status Bar ───────────────────────────────────────────────────── */
QStatusBar {
    background-color: rgba(40, 40, 40, 0.92);
    border-top: 1px solid #3a3a3c;
    color: #98989d;
    font-size: 11px;
    padding: 0 8px;
}

QStatusBar QLabel {
    background: transparent;
    color: #98989d;
    padding: 3px 8px;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: #3a3a3c;
    border: 1px solid #48484a;
    color: #f5f5f7;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px;
}

/* ── Message Box ──────────────────────────────────────────────────── */
QMessageBox {
    background-color: #1e1e1e;
}
QMessageBox QLabel { color: #f5f5f7; font-size: 13px; }
QMessageBox QPushButton { min-width: 80px; border-radius: 6px; }

/* ── Empty State Labels ──────────────────────────────────────────── */
QLabel#emptyStateIcon {
    font-size: 48px;
    color: #48484a;
    background: transparent;
}

QLabel#emptyStateText {
    font-size: 14px;
    color: #98989d;
    font-weight: 500;
    background: transparent;
}

/* ── Connection Status ────────────────────────────────────────────── */
QLabel#connectionStatusLabel {
    font-size: 12px;
    font-weight: 500;
}

/* ── Telemetry stat labels ────────────────────────────────────────── */
QLabel#telemetryStatTitle {
    font-size: 10px;
    color: #98989d;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QLabel#rpmValueLabel {
    font-size: 28px;
    font-weight: 700;
    color: #0a84ff;
}

QLabel#dutyValueLabel {
    font-size: 28px;
    font-weight: 700;
    color: #30d158;
}
